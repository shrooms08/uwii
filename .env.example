# Copy to .env.local (local) or set in the Vercel dashboard (see docs/DEPLOY.md). Never commit values.

# NEAR AI Cloud (TEE-attested classification); needed for live scans
NEAR_AI_API_KEY=

# NEAR testnet report anchoring. Testnet only.
NEAR_NETWORK=testnet
NEAR_ANCHOR_ACCOUNT_ID=
NEAR_ANCHOR_CONTRACT_ID=
NEAR_ANCHOR_PRIVATE_KEY=

# Hosted-demo daily caps (optional; defaults 150 and 100)
MAX_AI_CALLS_PER_DAY=
MAX_ANCHORS_PER_DAY=

# Optional data sources
NEAR_ARCHIVAL_RPC_URL=
COINGECKO_DEMO_API_KEY=
