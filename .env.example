# Copy to .env.local (local) or set in the Vercel dashboard (see docs/DEPLOY.md). Never commit values.

# NEAR AI Cloud (TEE-attested classification); needed for live scans
NEAR_AI_API_KEY=

# HMAC key that signs classification runs returned to the browser (at least 32 characters; generate with
# `openssl rand -hex 32`). Live scans are refused (503) without it; the cached demo still works.
UWII_RUN_SECRET=

# NEAR testnet report anchoring. Testnet only. NEAR_ANCHOR_PRIVATE_KEY must be a FUNCTION-CALL key limited
# to anchor() on the contract (the server refuses full-access keys). The full-access admin key belongs in
# .env.anchor-admin.local as NEAR_ANCHOR_ADMIN_PRIVATE_KEY (deploy script only). See docs/DEPLOY.md.
NEAR_NETWORK=testnet
NEAR_ANCHOR_ACCOUNT_ID=
NEAR_ANCHOR_CONTRACT_ID=
NEAR_ANCHOR_PRIVATE_KEY=

# Hosted-demo daily caps (optional; defaults 150 and 100)
MAX_AI_CALLS_PER_DAY=
MAX_ANCHORS_PER_DAY=

# Optional data sources
NEAR_ARCHIVAL_RPC_URL=
COINGECKO_DEMO_API_KEY=
